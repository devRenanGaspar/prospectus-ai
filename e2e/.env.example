# Template for `.env.e2e`, which lives in the repo ROOT (not in e2e/) and is
# gitignored by the `.env*` rule. Copy this file there and fill in the three
# secrets below.
#
#     cp e2e/.env.example .env.e2e
#
# Only these three are secrets. Everything else the suite needs — app URL,
# Supabase project, n8n hosts, workflow ids, the test lead — is checked into
# e2e/fixtures/env.ts, because none of it is confidential and pinning it in
# code is what makes a run reproducible.

# Password of the test account (renangasp@gmail.com) in the Prospectus app.
E2E_APP_PASSWORD=

# Supabase service_role key for the production project `tumqhovjzjojmrfoshou`.
# Dashboard -> Settings -> API Keys -> service_role (the secret one, not anon).
# This bypasses RLS entirely. The suite's write helpers are scoped to the test
# lead by construction; do not reuse this key for anything else.
E2E_SUPABASE_SERVICE_ROLE_KEY=

# n8n public API key. Generate it on the EDITOR host — https://nned.comunidademaia.com
# -> Settings -> n8n API. A key from any other n8n instance returns 401 here.
E2E_N8N_API_KEY=

# --- optional overrides; the defaults in e2e/fixtures/env.ts are correct ---
# E2E_APP_URL=https://prospectus.ia.br
# E2E_APP_EMAIL=renangasp@gmail.com
# E2E_SUPABASE_URL=https://tumqhovjzjojmrfoshou.supabase.co
# E2E_N8N_API_URL=https://nned.comunidademaia.com
# E2E_N8N_WEBHOOK_URL=https://nnwb.comunidademaia.com
# E2E_LEAD_EMAIL=renangaspar@hotmail.com
