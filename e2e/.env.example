# Template for `.env.e2e`, which lives in the repo ROOT (not in e2e/) and is
# gitignored by the `.env*` rule. Copy this file there and fill in every value
# below — none of it ships with placeholders in e2e/fixtures/env.ts, on
# purpose: this suite runs against a real account, a real WhatsApp number and
# a real n8n instance, and none of that belongs in a public repo.
#
#     cp e2e/.env.example .env.e2e
#
# Workflow ids, the test lead's UUID and the account's user_id ARE checked
# into e2e/fixtures/env.ts — those are just internal handles, and without the
# values below (the phone numbers, the email addresses, the n8n hosts, the
# unauthenticated webhook paths) they don't let anyone act on the account.

# Password of the test account in the Prospectus app.
E2E_APP_PASSWORD=

# Supabase service_role key for the production project. Dashboard -> Settings
# -> API Keys -> service_role (the secret one, not anon). This bypasses RLS
# entirely. The suite's write helpers are scoped to the test lead by
# construction; do not reuse this key for anything else.
E2E_SUPABASE_SERVICE_ROLE_KEY=

# n8n public API key. Generate it on the EDITOR host (see E2E_N8N_API_URL
# below) -> Settings -> n8n API. A key from any other n8n instance returns
# 401 here.
E2E_N8N_API_KEY=

# Email of the test account in the Prospectus app.
E2E_APP_EMAIL=

# n8n editor + REST API host. NOT the webhook host below.
E2E_N8N_API_URL=

# n8n webhook processor host. Serves /webhook/* only, no /api/v1.
E2E_N8N_WEBHOOK_URL=

# The account's real connected WhatsApp number, digits only (e.g. 55...).
E2E_AGENT_PHONE=

# The phone number the fixed test lead carries, digits only. Must be the
# ONLY lead in the account with this phone — both "Find Lead" nodes in n8n
# require count == 1, or the agent and the reply scorer break silently.
E2E_LEAD_PHONE=

# Inbox the SDR agent sends the TESTE 5 meeting invite to.
E2E_LEAD_EMAIL=

# Webhook path (starting with /webhook/...) that sends a WhatsApp message AS
# the lead — no auth beyond the path itself being unguessable. Find it on the
# PRS - 99_TestadorOficial_EnviaMensagem workflow's Webhook node.
E2E_WEBHOOK_TEST_SENDER_PATH=

# Webhook path on PRS - 30_Send_Message. Currently wired to nothing (posting
# to it 200s and does nothing) — kept for when that changes, not used today.
E2E_WEBHOOK_FORCE_SEND_QUEUE_PATH=

# --- optional overrides; the defaults in e2e/fixtures/env.ts are correct ---
# E2E_APP_URL=https://prospectus.ia.br
# E2E_SUPABASE_URL=https://<project-ref>.supabase.co
